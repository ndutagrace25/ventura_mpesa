# M-Pesa PayBill Service Configuration

# Server Settings
RUNNING_PORT=5003
API_PREFIX=/api/v1

# =============================================================================
# BACKEND API CONFIGURATION (Recommended - Dynamic Config)
# =============================================================================
# Backend URL for fetching M-Pesa configurations
BACKEND_URL=http://localhost:5020

# Internal API key for service-to-service authentication
# Must match INTERNAL_API_KEY in backend .env
INTERNAL_API_KEY=your_internal_api_key_here

# =============================================================================
# LEGACY CONFIGURATION (Fallback if backend is unavailable)
# =============================================================================
# M-Pesa PayBill/Till Configuration (used if BACKEND_URL is not set)
SHORTCODE=your_shortcode
PASSKEY=your_passkey
PARTYB=your_partyb_shortcode

# Safaricom API Credentials - Legacy (from Daraja portal)
CUSTOMER_KEY=your_consumer_key
CUSTOMER_SECRET=your_consumer_secret

# =============================================================================
# SAFARICOM API URLs (Required)
# =============================================================================
ACCESS_TOKEN_URL=https://api.safaricom.co.ke/oauth/v1/generate?grant_type=client_credentials
STK_PUSH_URL=https://api.safaricom.co.ke/mpesa/stkpush/v1/processrequest
REQUEST_STATUS_URL=https://api.safaricom.co.ke/mpesa/stkpushquery/v1/query

# =============================================================================
# CALLBACK URLs (Required - your backend endpoints)
# =============================================================================
CALLBACK=https://your-domain.com/api/callback/stkpush
VALIDATE_BILL_URL=https://your-domain.com/api/callback/validate-bill
